    uint ep=(ps&1u)*2u, w_val=(st.m_idx>=10u)?bc7_i4(0u,64u,idx):bc7_i3(0u,64u,idx);
    return uvec4(
        uint(clamp(bc6h_finish(bc7_w(st.r[ep],st.r[ep+1],w_val),st.isSigned)*255.5,0.0,255.0)),
        uint(clamp(bc6h_finish(bc7_w(st.g[ep],st.g[ep+1],w_val),st.isSigned)*255.5,0.0,255.0)),
        uint(clamp(bc6h_finish(bc7_w(st.b[ep],st.b[ep+1],w_val),st.isSigned)*255.5,0.0,255.0)),
