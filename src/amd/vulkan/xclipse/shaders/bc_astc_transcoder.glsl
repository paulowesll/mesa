    for (uint q = 0u; q < 5u; q++) {
        int d = int(bc5_q5_value(e0, e1, q)) - int(v);
        uint err = uint(d * d);
        if (err < best_err) { best_err = err; best = q; }
    }
    return best;
}

uint bc5_q5_error(uint v[ASTC_BLOCK_TEXELS], uint e0, uint e1) {
    uint total = 0u;
    for (uint i = 0u; i < ASTC_BLOCK_TEXELS; i++) {
        int d = int(bc5_q5_value(e0, e1, bc5_q5_pick(e0, e1, v[i]))) - int(v[i]);
        total += uint(d * d);
    }
    return total;
}

/* Endpoints for one channel.  With only five weight levels the extremes are
 * rarely the best endpoints, so start from min/max and refit by least squares
 * against the weights they select, keeping whichever pair errs least. */
uvec2 bc5_fit_channel(uint v[ASTC_BLOCK_TEXELS]) {
    uint lo = 255u, hi = 0u;
    for (uint i = 0u; i < ASTC_BLOCK_TEXELS; i++) {
        lo = min(lo, v[i]);
        hi = max(hi, v[i]);
    }
    uvec2 best = uvec2(lo, hi);
    uint best_err = bc5_q5_error(v, lo, hi);
    uint e0 = lo, e1 = hi;
    for (uint it = 0u; it < 3u && best_err != 0u; it++) {
        float a = 0.0, b = 0.0, c = 0.0, d = 0.0, e = 0.0;
        for (uint i = 0u; i < ASTC_BLOCK_TEXELS; i++) {
            float t = float(bc5_q5_pick(e0, e1, v[i])) * 0.25;
            float x = float(v[i]);
            a += (1.0 - t) * (1.0 - t);
            b += t * (1.0 - t);
            c += t * t;
            d += x * (1.0 - t);
            e += x * t;
        }
        float det = a * c - b * b;
        if (abs(det) < 1e-4)
            break;
        e0 = uint(clamp(round((d * c - b * e) / det), 0.0, 255.0));
        e1 = uint(clamp(round((a * e - b * d) / det), 0.0, 255.0));
        uint err = bc5_q5_error(v, e0, e1);
        if (err < best_err) {
            best_err = err;
            best = uvec2(e0, e1);
        }
    }
    return best;
}

uvec4 encode_bc5_dual_plane(uvec4 s[ASTC_BLOCK_TEXELS]) {
    uint x[ASTC_BLOCK_TEXELS], y[ASTC_BLOCK_TEXELS];
    for (uint i = 0u; i < ASTC_BLOCK_TEXELS; i++) {
        x[i] = s[i].r;
        y[i] = s[i].a;
    }
    uvec2 ex = bc5_fit_channel(x), ey = bc5_fit_channel(y);
    uint lo0 = ex.x, hi0 = ex.y, lo1 = ey.x, hi1 = ey.y;
    uint w[32];
    for (uint i = 0u; i < ASTC_BLOCK_TEXELS; i++) {
        w[2u * i + 0u] = bc5_q5_pick(lo0, hi0, s[i].r);
        w[2u * i + 1u] = bc5_q5_pick(lo1, hi1, s[i].a);
    }

    uvec4 b = uvec4(0u);
    astc_write(1106u, 11u, 0u, b);   /* block mode */
    astc_write(0u, 2u, 11u, b);      /* one partition */
    astc_write(4u, 4u, 13u, b);      /* CEM 4: L0 L1 A0 A1 */
    astc_write(lo0, 8u, 17u, b);
    astc_write(hi0, 8u, 25u, b);
    astc_write(lo1, 8u, 33u, b);
    astc_write(hi1, 8u, 41u, b);
    astc_write(3u, 2u, 51u, b);      /* CCS: plane 1 drives alpha; 128-75-2 */

    /* 32 interleaved weights (plane 0, plane 1 per texel) as quints: ten
     * groups of three (7 bits each) and a two-value tail (5 bits). */
    uvec4 wb = uvec4(0u);
    uint o = 0u;
    for (uint g = 0u; g < 10u; g++) {
        uint i = g * 3u;
        astc_write(astc_quint_enc[w[i] + 5u * w[i + 1u] + 25u * w[i + 2u]], 7u, o, wb);
        o += 7u;
    }
    astc_write(astc_quint_enc[w[30] + 5u * w[31]] & 31u, 5u, o, wb);

    /* Weights are stored bit-reversed from the top of the block. */
    b.x |= bitfieldReverse(wb.w);
    b.y |= bitfieldReverse(wb.z);
    b.z |= bitfieldReverse(wb.y);
    b.w |= bitfieldReverse(wb.x);
    return b;
}

#if 1
void main() {
   uvec3 gid = gl_GlobalInvocationID;
   uint bx = gid.x, by = gid.y, slice = gid.z;
   if (bx * ASTC_BLOCK_WIDTH >= pc.width ||
       by * ASTC_BLOCK_HEIGHT >= pc.height) return;

   uvec4 s[ASTC_BLOCK_TEXELS];
   bool inv = (pc.src_layout == SRC_BC5_UNORM_INVG);
   uint amin = 255u, amax = 0u;
#if defined(XCLIPSE_ASTC_BC6H_SPECIALIZED)
   /* BC6H has no alpha channel; its decoded alpha is always opaque. */
   amax = 255u;
#endif

   uvec4 fetched = fetch_block(ivec3(bx, by, slice) + pc.offset);
   uvec2 bc4_block = uvec2(0u);
   uvec4 bc_block = uvec4(0u);
   /* BC4 occupies only eight bytes.  Do not issue the generic sixteen-byte
    * load for it: the last BC4 block in a row would otherwise read past the
    * source buffer, even though the extra words are not consumed below. */
   if (PIPELINE_MODE != 3u &&
       (pc.src_layout == SRC_BC4_UNORM || pc.src_layout == SRC_BC4_SNORM)) {
       bc4_block = fetched.xy;
   } else {
       bc_block = fetched;
   }

   BC7State bc7_st; BC6HState bc6h_st; BC4State bc4_st0, bc4_st1;
   if (PIPELINE_MODE == 2) {
       if (pc.src_layout == SRC_BC7_RAW) bc7_st = parse_bc7(bc_block);
   } else if (PIPELINE_MODE == 1) {
#if defined(XCLIPSE_ASTC_BC6H_SPECIALIZED)
       bc6h_st = parse_bc6h(bc_block, BC6H_SIGNED_MODE != 0u);
#else
       if (pc.src_layout == SRC_BC6H_UFLOAT || pc.src_layout == SRC_BC6H_SFLOAT)
           bc6h_st = parse_bc6h(bc_block, pc.src_layout == SRC_BC6H_SFLOAT);
#endif
   } else {
       if (PIPELINE_MODE != 3u &&
           (pc.src_layout == SRC_BC4_UNORM || pc.src_layout == SRC_BC4_SNORM)) {
           bc4_st0 = parse_bc4(bc4_block.x, bc4_block.y, pc.src_layout == SRC_BC4_SNORM);
       }
       else if (PIPELINE_MODE == 3u ||
                pc.src_layout == SRC_BC5_UNORM ||
                pc.src_layout == SRC_BC5_SNORM ||
                pc.src_layout == SRC_BC5_UNORM_INVG) {
           bc4_st0 = parse_bc4(bc_block.x, bc_block.y, pc.src_layout == SRC_BC5_SNORM);
           bc4_st1 = parse_bc4(bc_block.z, bc_block.w, pc.src_layout == SRC_BC5_SNORM);
       }
   }

   for (uint r = 0u; r < ASTC_BLOCK_HEIGHT; r++) {
       for (uint c = 0u; c < ASTC_BLOCK_WIDTH; c++) {
           uint idx = r * ASTC_BLOCK_WIDTH + c;
           if (PIPELINE_MODE == 2) {
               if (pc.src_layout == SRC_BC7_RAW) s[idx] = decode_bc7_pixel(bc7_st, idx);
           } else if (PIPELINE_MODE == 1) {
#if defined(XCLIPSE_ASTC_BC6H_SPECIALIZED)
               s[idx] = decode_bc6h_pixel(bc6h_st, idx);
#else
               if (pc.src_layout == SRC_BC6H_UFLOAT || pc.src_layout == SRC_BC6H_SFLOAT) s[idx] = decode_bc6h_pixel(bc6h_st, idx);
#endif
           } else {
               if (PIPELINE_MODE != 3u &&
                   (pc.src_layout == SRC_BC4_UNORM ||
                    pc.src_layout == SRC_BC4_SNORM)) {
                   /* The backing view maps only R for BC4.  Keep the other
                    * channels neutral and alpha opaque so the generic fit
                    * does not spend work encoding data that the view hides. */
                   s[idx] = uvec4(decode_bc4_pixel(bc4_st0, idx),
                                  0u, 0u, 255u);
               } else if (PIPELINE_MODE == 3u ||
                          pc.src_layout == SRC_BC5_UNORM ||
                          pc.src_layout == SRC_BC5_SNORM ||
                          pc.src_layout == SRC_BC5_UNORM_INVG) {
                   s[idx] = uvec4(decode_bc4_pixel(bc4_st0, idx), 0u, 0u, decode_bc4_pixel(bc4_st1, idx));
                   if (inv) s[idx].a = 255u - s[idx].a;
               }
           }
           
#if !defined(XCLIPSE_ASTC_BC6H_SPECIALIZED)
           amin = min(amin, s[idx].a);
           amax = max(amax, s[idx].a);
#endif
       }
   }

#if !defined(XCLIPSE_ASTC_BC6H_SPECIALIZED)
   if (PIPELINE_MODE == 3u) {
       store_block(ivec3(bx, by, slice) + pc.offset, encode_bc5_dual_plane(s));
       return;
   }
#endif
#if defined(XCLIPSE_ASTC_BC6H_SPECIALIZED)
   uint aw = 0u;
#else
   uint aw = (amax - amin < 8u) ? 0u : 12u;
#endif
   bool bc4_source = PIPELINE_MODE != 3u &&
                     (pc.src_layout == SRC_BC4_UNORM ||
                      pc.src_layout == SRC_BC4_SNORM);
   bool bc5_source = PIPELINE_MODE == 3u ||
                     pc.src_layout == SRC_BC5_UNORM ||
                     pc.src_layout == SRC_BC5_SNORM ||
                     pc.src_layout == SRC_BC5_UNORM_INVG;
   uvec4 mean = bc4_source ? uvec4(0u, 0u, 0u, 255u) : uvec4(0u);
   if (!bc4_source) {
       if (bc5_source) {
           uvec2 mean_ra = uvec2(0u);
           for (uint i = 0u; i < ASTC_BLOCK_TEXELS; i++)
               mean_ra += uvec2(s[i].r, s[i].a);
           mean = uvec4((mean_ra.x + 8u) / ASTC_BLOCK_TEXELS,
                        0u, 0u,
                        (mean_ra.y + 8u) / ASTC_BLOCK_TEXELS);
       } else {
           for (uint i = 0u; i < ASTC_BLOCK_TEXELS; i++) mean += s[i];
           mean = (mean + 8u) / ASTC_BLOCK_TEXELS;
       }
   }

    uvec4 ep0, ep1;
    if (bc4_source) {
        /* BC4 is scalar data.  Its extrema are already the useful ASTC
         * endpoints, so avoid the generic PCA/centroid iterations used by
         * BC5, BC6H and the fallback BC7 encoder. */
        ep0 = uvec4(255u, 0u, 0u, 255u);
        ep1 = uvec4(0u, 0u, 0u, 255u);
        for (uint i = 0u; i < ASTC_BLOCK_TEXELS; i++) {
            ep0 = min(ep0, s[i]);
            ep1 = max(ep1, s[i]);
        }
    } else
#if defined(XCLIPSE_BC7_LAYER_ENCODER)
    if (PIPELINE_MODE == 2u) {
        /* Match bcn_layer's stable first-order fit for BC7.  Keeping the
         * actual per-block extrema is important for small isolated colors;
         * the iterative centroid fit can discard those extrema before ASTC
         * quantization and turn them into bright/dark speckles. */
        ep0 = uvec4(255u);
        ep1 = uvec4(0u);
        for (uint i = 0u; i < ASTC_BLOCK_TEXELS; i++) {
            ep0 = min(ep0, s[i]);
            ep1 = max(ep1, s[i]);
        }
    } else
#endif
    {
        ivec4 axis = ivec4(0);
        int max_dist = -1;
        for (uint i = 0u; i < ASTC_BLOCK_TEXELS; i++) {
            ivec4 d = ivec4(s[i]) - ivec4(mean);
#if defined(XCLIPSE_ASTC_BC6H_SPECIALIZED)
            int dist = d.r*d.r + d.g*d.g + d.b*d.b;
#else
            int dist;
            if (bc5_source)
                dist = d.r*d.r + d.a*d.a*int(aw);
            else
                dist = d.r*d.r + d.g*d.g + d.b*d.b + d.a*d.a;
#endif
            if (dist > max_dist) {
                max_dist = dist;
                axis = d;
            }
        }
        if (max_dist == 0) {
            if (bc5_source)
                axis = ivec4(3, 0, 0, int(aw));
            else
                axis = ivec4(3, 4, 2, int(aw));
        }

        int proj_min = 0x7FFFFFFF;
        int proj_max = -0x7FFFFFFF;
        ep0 = s[0]; ep1 = s[0];
        for (uint i = 0u; i < ASTC_BLOCK_TEXELS; i++) {
            ivec4 d = ivec4(s[i]) - ivec4(mean);
#if defined(XCLIPSE_ASTC_BC6H_SPECIALIZED)
            int proj = d.r * axis.r + d.g * axis.g + d.b * axis.b;
#else
            int proj;
            if (bc5_source)
                proj = d.r * axis.r + d.a * axis.a;
            else
                proj = d.r * axis.r + d.g * axis.g + d.b * axis.b + d.a * axis.a;
#endif
            if (proj < proj_min) { proj_min = proj; ep0 = s[i]; }
            if (proj > proj_max) { proj_max = proj; ep1 = s[i]; }
        }

        uint fit_iterations = 2u;
#if defined(XCLIPSE_ASTC_BC6H_SPECIALIZED)
        fit_iterations = BC6H_FAST_MODE != 0u ? 1u : 2u;
#endif
        for (uint it = 0u; it < fit_iterations; it++) {
            uvec4 sum0 = uvec4(0u), sum1 = uvec4(0u);
            uint cnt0 = 0u, cnt1 = 0u;
            for (uint i = 0u; i < ASTC_BLOCK_TEXELS; i++) {
                ivec4 d0 = ivec4(s[i]) - ivec4(ep0);
                ivec4 d1 = ivec4(s[i]) - ivec4(ep1);
#if defined(XCLIPSE_ASTC_BC6H_SPECIALIZED)
                int dist0 = d0.r*d0.r*3 + d0.g*d0.g*4 + d0.b*d0.b*2;
                int dist1 = d1.r*d1.r*3 + d1.g*d1.g*4 + d1.b*d1.b*2;
#else
                int dist0, dist1;
                if (bc5_source) {
                    dist0 = d0.r*d0.r*3 + d0.a*d0.a*int(aw);
                    dist1 = d1.r*d1.r*3 + d1.a*d1.a*int(aw);
                } else {
                    dist0 = d0.r*d0.r*3 + d0.g*d0.g*4 +
                            d0.b*d0.b*2 + d0.a*d0.a*int(aw);
                    dist1 = d1.r*d1.r*3 + d1.g*d1.g*4 +
                            d1.b*d1.b*2 + d1.a*d1.a*int(aw);
                }
#endif
                if (dist0 <= dist1) {
                    sum0 += s[i]; cnt0++;
                } else {
                    sum1 += s[i]; cnt1++;
                }
            }
            if (cnt0 > 0u) ep0 = (sum0 + (cnt0 >> 1u)) / cnt0;
            if (cnt1 > 0u) ep1 = (sum1 + (cnt1 >> 1u)) / cnt1;
        }
    }

    if (aw == 0u) {
        ep0.a = mean.a;
        ep1.a = mean.a;
    }

#if !defined(XCLIPSE_BC7_LAYER_ENCODER)
    if (ep0.r * 3u + ep0.g * 4u + ep0.b > ep1.r * 3u + ep1.g * 4u + ep1.b) {
        uvec4 t = ep0;
        ep0 = ep1;
        ep1 = t;
    }
#endif

    vec4 ep0f = vec4(ep0), ep1f = vec4(ep1);
    vec4 ax = ep1f - ep0f;
#if defined(XCLIPSE_ASTC_BC6H_SPECIALIZED)
    float den = max(dot(ax.rgb, ax.rgb), 0.001);
#else
    float den;
    if (bc5_source)
        den = max(dot(vec2(ax.r, ax.a), vec2(ax.r, ax.a)), 0.001);
    else
        den = max(dot(ax, ax), 0.001);
#endif

    float min_t = 1.0;
    float max_t = 0.0;
    if (!bc4_source && den > 0.001) {
        for (uint i = 0u; i < ASTC_BLOCK_TEXELS; i++) {
#if defined(XCLIPSE_ASTC_BC6H_SPECIALIZED)
            float t = dot(vec3(s[i].rgb) - ep0f.rgb, ax.rgb) / den;
#else
            float t;
            if (bc5_source)
                t = dot(vec2(s[i].r, s[i].a) -
                        vec2(ep0f.r, ep0f.a),
                        vec2(ax.r, ax.a)) / den;
            else
                t = dot(vec4(s[i]) - ep0f, ax) / den;
#endif
            min_t = min(min_t, t);
            max_t = max(max_t, t);
        }
        vec4 adjusted_ep0 = ep0f + min_t * ax;
        vec4 adjusted_ep1 = ep0f + max_t * ax;
        ep0f = clamp(round(adjusted_ep0), 0.0, 255.0);
        ep1f = clamp(round(adjusted_ep1), 0.0, 255.0);
        ep0 = uvec4(ep0f);
        ep1 = uvec4(ep1f);
        
        ax = ep1f - ep0f;
#if defined(XCLIPSE_ASTC_BC6H_SPECIALIZED)
        den = max(dot(ax.rgb, ax.rgb), 0.001);
#else
        if (bc5_source)
            den = max(dot(vec2(ax.r, ax.a), vec2(ax.r, ax.a)), 0.001);
        else
            den = max(dot(ax, ax), 0.001);
#endif
    }

    uvec4 pcb = uvec4(0u);
#ifdef XCLIPSE_ASTC_QUALITY_4BIT
    /* The 16 four-bit weights occupy exactly two dwords.  Packing them
     * directly avoids 16 calls through the generic cross-dword bit writer;
     * unlike the 3-bit layout, no weight can straddle a dword boundary. */
    uint weight_lo = 0u;
    uint weight_hi = 0u;
    for (uint i = 0u; i < ASTC_BLOCK_TEXELS; i++) {
#if defined(XCLIPSE_ASTC_BC6H_SPECIALIZED)
        float t = clamp(dot(vec3(s[i].rgb) - ep0f.rgb, ax.rgb) / den, 0.0, 1.0);
#else
        float t;
        if (bc5_source)
            t = clamp(dot(vec2(s[i].r, s[i].a) -
                          vec2(ep0f.r, ep0f.a),
                          vec2(ax.r, ax.a)) / den, 0.0, 1.0);
        else
            t = clamp(dot(vec4(s[i]) - ep0f, ax) / den, 0.0, 1.0);
#endif
        uint qw = uint(round(t * 15.0)) & 15u;
        uint bit = i * 4u;
        if (bit < 32u)
            weight_lo |= qw << bit;
        else
            weight_hi |= qw << (bit - 32u);
    }
    pcb.z = bitfieldReverse(weight_hi);
    pcb.w = bitfieldReverse(weight_lo);
#else
    for (uint i = 0u; i < ASTC_BLOCK_TEXELS; i++) {
#if defined(XCLIPSE_ASTC_BC6H_SPECIALIZED)
        float t = clamp(dot(vec3(s[i].rgb) - ep0f.rgb, ax.rgb) / den, 0.0, 1.0);
#else
        float t;
        if (bc5_source)
            t = clamp(dot(vec2(s[i].r, s[i].a) -
                          vec2(ep0f.r, ep0f.a),
                          vec2(ax.r, ax.a)) / den, 0.0, 1.0);
        else
            t = clamp(dot(vec4(s[i]) - ep0f, ax) / den, 0.0, 1.0);
#endif
#if defined(XCLIPSE_ASTC_QUALITY_3BIT)
        uint qw = uint(round(t * 7.0));
        astc_write(qw & 7u, 3u, i * 3u, pcb);
#else
        uint qw = uint(round(t * 3.0));
        astc_write(qw & 3u, 2u, i * 2u, pcb);
#endif
    }

    uvec4 wb;
    wb.x = bitfieldReverse(pcb.w);
    wb.y = bitfieldReverse(pcb.z);
    wb.z = bitfieldReverse(pcb.y);
    wb.w = bitfieldReverse(pcb.x);
    pcb = wb;
#endif

#ifdef XCLIPSE_ASTC_QUALITY_4BIT
    astc_write(578u, 11u, 0u, pcb);
#elif defined(XCLIPSE_ASTC_QUALITY_3BIT)
    astc_write(83u, 11u, 0u, pcb);
#else
    astc_write(66u, 11u, 0u, pcb);
#endif
    astc_write(0u, 2u, 11u, pcb);
    bool opaque_bc7 = PIPELINE_MODE == 2 &&
                      pc.src_layout == SRC_BC7_RAW &&
                      amin == 255u && amax == 255u;
#ifdef XCLIPSE_BC7_OPAQUE_CEM8
    if (opaque_bc7) {
        /* CEM8 is LDR RGB direct with implicit opaque alpha.  With the
         * quality-4 block mode its six endpoints use QUANT_192 (six base
         * bits plus trits), not six raw eight-bit fields. */
        astc_write(8u, 4u, 13u, pcb);
        uint rgb_ev[6] = uint[](astc_quant_trit6(ep0.r),
                                astc_quant_trit6(ep1.r),
                                astc_quant_trit6(ep0.g),
                                astc_quant_trit6(ep1.g),
                                astc_quant_trit6(ep0.b),
                                astc_quant_trit6(ep1.b));
        astc_write_trit_group(rgb_ev[0], rgb_ev[1], rgb_ev[2],
                              rgb_ev[3], rgb_ev[4], 17u, false, pcb);
        /* Five QUANT_192 values occupy 38 bits; the sixth value is the
         * one-element integer-sequence tail at bit 55. */
        astc_write_trit_tail1(rgb_ev[5], 55u, pcb);
    } else
#endif
    {
        astc_write(12u, 4u, 13u, pcb);
        uint ev[8]; ev[0] = ep0.r; ev[1] = ep1.r; ev[2] = ep0.g; ev[3] = ep1.g; ev[4] = ep0.b; ev[5] = ep1.b; ev[6] = ep0.a; ev[7] = ep1.a;
#ifdef XCLIPSE_ASTC_QUALITY_4BIT
        uint qev[8];
        for (uint i = 0u; i < 8u; i++)
            qev[i] = astc_quant_trit4(ev[i]);
        astc_write_trit_group_n(qev[0], qev[1], qev[2], qev[3], qev[4],
                                17u, false, 4u, pcb);
        astc_write_trit_group_n(qev[5], qev[6], qev[7], 0u, 0u,
                                45u, true, 4u, pcb);
#elif defined(XCLIPSE_ASTC_QUALITY_3BIT)
        uint qev[8];
        for (uint i = 0u; i < 8u; i++)
            qev[i] = astc_quant_trit6(ev[i]);
        astc_write_trit_group(qev[0], qev[1], qev[2], qev[3], qev[4],
                              17u, false, pcb);
        astc_write_trit_group(qev[5], qev[6], qev[7], 0u, 0u,
                              55u, true, pcb);
#else
        uint o = 17u; for (uint i = 0u; i < 8u; i++) { astc_write(ev[i] & 255u, 8u, o, pcb); o += 8u; }
#endif
    }
    
   store_block(ivec3(bx, by, slice) + pc.offset, pcb);
}
#endif
