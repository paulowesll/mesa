uvec4 decode_bc6h_pixel(BC6HState st, uint i) {
    if (st.m_idx > 13u) return uvec4(0u);
    uint ps=(st.m_idx>=10u)?((i==0u)?128u:0u):get_p6h(st.partition_index*16u+i);
