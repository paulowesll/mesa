#extension GL_EXT_shader_8bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#ifndef XCLIPSE_ASTC_LOCAL_SIZE_X
#define XCLIPSE_ASTC_LOCAL_SIZE_X 8
#endif
#ifndef XCLIPSE_ASTC_LOCAL_SIZE_Y
#define XCLIPSE_ASTC_LOCAL_SIZE_Y 8
#endif
layout(local_size_x = XCLIPSE_ASTC_LOCAL_SIZE_X,
       local_size_y = XCLIPSE_ASTC_LOCAL_SIZE_Y, local_size_z = 1) in;

/* Keep the ASTC backing block at 16 bytes and use the 3-bit weight mode by
 * default.  The quality build overrides this with the 4-bit mode. */
#if !defined(XCLIPSE_ASTC_QUALITY_3BIT) && \
    !defined(XCLIPSE_ASTC_QUALITY_4BIT)
#define XCLIPSE_ASTC_QUALITY_3BIT
#endif

layout(constant_id = 0) const uint PIPELINE_MODE = 0;
/* BC6H U/S share the decoder, but keeping signedness as a runtime branch
 * makes the Samsung compiler generate one large mixed path.  The BC6H
 * module specializes it per pipeline; the normal module keeps the original
 * dynamic path so BC4/5 and BC7 remain on the known-good shader. */
#if defined(XCLIPSE_ASTC_BC6H_SPECIALIZED)
layout(constant_id = 1) const uint BC6H_SIGNED_MODE = 0;
layout(constant_id = 2) const uint BC6H_FAST_MODE = 0;
#endif
layout(push_constant) uniform PushConsts {
    ivec3 offset;      /* first block of the copy region; z = first slice */
    uint width;        /* region extent in texels */
    uint height;
    uint src_layout;   /* SRC_* below */
    int image_type;    /* VkImageType */
} pc;
/* Same binding order as bc_decoder.glsl: 0 = output, 1 = compressed input. */
layout(set = 0, binding = 0) writeonly uniform uimage2DArray OutputImage2DArray;
layout(set = 0, binding = 0) writeonly uniform uimage3D OutputImage3D;
layout(set = 0, binding = 1) uniform utexture2DArray PayloadInput2DArray;
layout(set = 0, binding = 1) uniform utexture3D PayloadInput3D;

uvec4 fetch_block(ivec3 block) {
    return pc.image_type == 2 ? texelFetch(PayloadInput3D, block, 0)
                              : texelFetch(PayloadInput2DArray, block, 0);
}

void store_block(ivec3 block, uvec4 astc) {
    if (pc.image_type == 2)
        imageStore(OutputImage3D, block, astc);
    else
        imageStore(OutputImage2DArray, block, astc);
}

/* The encoder emits one fixed ASTC 4x4 block for every BC block.  Keep the
 * geometry explicit here: the source BC format may change, but the ASTC
 * block size must never be selected dynamically. */
