void astc_write_trit_group_n(uint a, uint b, uint c, uint d, uint e,
                             uint o, bool short_block, uint n,
                             inout uvec4 block) {
    /* t_tab is the ASTC TritQuint inverse table: its base-3 index is the
     * five decoded trits and its value is the packed code.  The previous
     * implementation rediscovered that value by scanning up to 256 codes
     * for every endpoint group. */
    uint code = astc_trit(a >> n, b >> n, c >> n, d >> n, e >> n);
    astc_write(a & 63u, n, o + 0u, block);
    astc_write((code >> 0u) & 1u, 1u, o + n, block);
    astc_write((code >> 1u) & 1u, 1u, o + n + 1u, block);
    astc_write(b & 63u, n, o + n + 2u, block);
    astc_write((code >> 2u) & 1u, 1u, o + 2u * n + 2u, block);
    astc_write((code >> 3u) & 1u, 1u, o + 2u * n + 3u, block);
    astc_write(c & 63u, n, o + 2u * n + 4u, block);
    astc_write((code >> 4u) & 1u, 1u, o + 3u * n + 4u, block);
    if (short_block)
        return;
    astc_write(d & 63u, n, o + 3u * n + 5u, block);
    astc_write((code >> 5u) & 1u, 1u, o + 4u * n + 5u, block);
    astc_write((code >> 6u) & 1u, 1u, o + 4u * n + 6u, block);
    astc_write(e & 63u, n, o + 4u * n + 7u, block);
    astc_write((code >> 7u) & 1u, 1u, o + 5u * n + 7u, block);
}

void astc_write_trit_group(uint a, uint b, uint c, uint d, uint e,
                           uint o, bool short_block, inout uvec4 block) {
    astc_write_trit_group_n(a, b, c, d, e, o, short_block, 6u, block);
}

/* QUANT_192 has six base bits plus trits.  The last group in the six-value
 * CEM8 endpoint sequence contains one value, so only the first two trit bits
 * are present.  Padding this tail as a complete five-value group changes the
 * endpoint bit count seen by the ASTC decoder and is not equivalent to the
 * integer-sequence encoding used by the reference encoder. */
void astc_write_trit_tail1(uint value, uint o, inout uvec4 block) {
    uint code = astc_trit(value >> 6u, 0u, 0u, 0u, 0u);
    astc_write(value & 63u, 6u, o, block);
    astc_write(code & 3u, 2u, o + 6u, block);
}

