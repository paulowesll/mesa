        v = (word0 >> bit) & bc_mask(c);
    } else {
        uint word1 = idx == 0u ? w.y : idx == 1u ? w.z : idx == 2u ? w.w : 0u;
        v = ((word0 >> bit) | (word1 << (32u - bit))) & bc_mask(c);
