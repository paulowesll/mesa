    else if (mode == 0x1Au) { st.r[0]|=int(bc6h_read(w,p,8u)); st.b[3]|=int(bc6h_read(w,p,1u))<<1; st.b[2]|=int(bc6h_read(w,p,1u))<<4; st.g[0]|=int(bc6h_read(w,p,8u)); st.b[2]|=int(bc6h_read(w,p,1u))<<5; st.g[2]|=int(bc6h_read(w,p,1u))<<4; st.b[0]|=int(bc6h_read(w,p,8u)); st.b[3]|=int(bc6h_read(w,p,1u))<<5; st.b[3]|=int(bc6h_read(w,p,1u))<<4; st.r[1]|=int(bc6h_read(w,p,5u)); st.g[3]|=int(bc6h_read(w,p,1u))<<4; st.g[2]|=int(bc6h_read(w,p,4u)); st.g[1]|=int(bc6h_read(w,p,5u)); st.b[3]|=int(bc6h_read(w,p,1u)); st.g[3]|=int(bc6h_read(w,p,4u)); st.b[1]|=int(bc6h_read(w,p,6u)); st.b[2]|=int(bc6h_read(w,p,4u)); st.r[2]|=int(bc6h_read(w,p,5u)); st.b[3]|=int(bc6h_read(w,p,1u))<<2; st.r[3]|=int(bc6h_read(w,p,5u)); st.b[3]|=int(bc6h_read(w,p,1u))<<3; st.partition_index=bc6h_read(w,p,5u); st.m_idx=8u; }
    else if (mode == 0x1Eu) { st.r[0]|=int(bc6h_read(w,p,6u)); st.g[3]|=int(bc6h_read(w,p,1u))<<4; st.b[3]|=int(bc6h_read(w,p,1u)); st.b[3]|=int(bc6h_read(w,p,1u))<<1; st.b[2]|=int(bc6h_read(w,p,1u))<<4; st.g[0]|=int(bc6h_read(w,p,6u)); st.g[2]|=int(bc6h_read(w,p,1u))<<5; st.b[2]|=int(bc6h_read(w,p,1u))<<5; st.b[3]|=int(bc6h_read(w,p,1u))<<2; st.g[2]|=int(bc6h_read(w,p,1u))<<4; st.b[0]|=int(bc6h_read(w,p,6u)); st.g[3]|=int(bc6h_read(w,p,1u))<<5; st.b[3]|=int(bc6h_read(w,p,1u))<<3; st.b[3]|=int(bc6h_read(w,p,1u))<<5; st.b[3]|=int(bc6h_read(w,p,1u))<<4; st.r[1]|=int(bc6h_read(w,p,6u)); st.g[2]|=int(bc6h_read(w,p,4u)); st.g[1]|=int(bc6h_read(w,p,6u)); st.g[3]|=int(bc6h_read(w,p,4u)); st.b[1]|=int(bc6h_read(w,p,6u)); st.b[2]|=int(bc6h_read(w,p,4u)); st.r[2]|=int(bc6h_read(w,p,6u)); st.r[3]|=int(bc6h_read(w,p,6u)); st.partition_index=bc6h_read(w,p,5u); st.m_idx=9u; }
    else if (mode == 0x03u) { st.r[0]|=int(bc6h_read(w,p,10u)); st.g[0]|=int(bc6h_read(w,p,10u)); st.b[0]|=int(bc6h_read(w,p,10u)); st.r[1]|=int(bc6h_read(w,p,10u)); st.g[1]|=int(bc6h_read(w,p,10u)); st.b[1]|=int(bc6h_read(w,p,10u)); st.m_idx=10u; }
    else if (mode == 0x07u) { st.r[0]|=int(bc6h_read(w,p,10u)); st.g[0]|=int(bc6h_read(w,p,10u)); st.b[0]|=int(bc6h_read(w,p,10u)); st.r[1]|=int(bc6h_read(w,p,9u)); st.r[0]|=int(bc6h_read(w,p,1u))<<10; st.g[1]|=int(bc6h_read(w,p,9u)); st.g[0]|=int(bc6h_read(w,p,1u))<<10; st.b[1]|=int(bc6h_read(w,p,9u)); st.b[0]|=int(bc6h_read(w,p,1u))<<10; st.m_idx=11u; }
    else if (mode == 0x0Bu) { st.r[0]|=int(bc6h_read(w,p,10u)); st.g[0]|=int(bc6h_read(w,p,10u)); st.b[0]|=int(bc6h_read(w,p,10u)); st.r[1]|=int(bc6h_read(w,p,8u)); st.r[0]|=int(bc6h_read_r(w,p,2u))<<10; st.g[1]|=int(bc6h_read(w,p,8u)); st.g[0]|=int(bc6h_read_r(w,p,2u))<<10; st.b[1]|=int(bc6h_read(w,p,8u)); st.b[0]|=int(bc6h_read_r(w,p,2u))<<10; st.m_idx=12u; }
    else if (mode == 0x0Fu) { st.r[0]|=int(bc6h_read(w,p,10u)); st.g[0]|=int(bc6h_read(w,p,10u)); st.b[0]|=int(bc6h_read(w,p,10u)); st.r[1]|=int(bc6h_read(w,p,4u)); st.r[0]|=int(bc6h_read_r(w,p,6u))<<10; st.g[1]|=int(bc6h_read(w,p,4u)); st.g[0]|=int(bc6h_read_r(w,p,6u))<<10; st.b[1]|=int(bc6h_read(w,p,4u)); st.b[0]|=int(bc6h_read_r(w,p,6u))<<10; st.m_idx=13u; }
    else { return st; }

    uint numPartitions=(st.m_idx>=10u)?0u:1u; const uint bits0[14]=uint[](10,7,11,11,11,9,8,8,8,6,10,11,12,16); const uint bits_dr[14]=uint[](5,6,5,4,4,5,6,5,5,6,10,9,8,4), bits_dg[14]=uint[](5,6,4,5,4,5,5,6,5,6,10,9,8,4), bits_db[14]=uint[](5,6,4,4,5,5,5,5,6,6,10,9,8,4); uint b0=bits0[st.m_idx];
    if (isSigned) { st.r[0]=bc6h_extend_sign(st.r[0],b0); st.g[0]=bc6h_extend_sign(st.g[0],b0); st.b[0]=bc6h_extend_sign(st.b[0],b0); }
    if ((st.m_idx!=9u&&st.m_idx!=10u)||isSigned) { uint bdr=bits_dr[st.m_idx],bdg=bits_dg[st.m_idx],bdb=bits_db[st.m_idx]; for(uint i=1u;i<(numPartitions+1u)*2u;i++){ st.r[i]=bc6h_extend_sign(st.r[i],bdr); st.g[i]=bc6h_extend_sign(st.g[i],bdg); st.b[i]=bc6h_extend_sign(st.b[i],bdb); } }
    if (st.m_idx!=9u&&st.m_idx!=10u) { for(uint i=1u;i<(numPartitions+1u)*2u;i++){ st.r[i]=bc6h_transform_inverse(st.r[i],st.r[0],b0,isSigned); st.g[i]=bc6h_transform_inverse(st.g[i],st.g[0],b0,isSigned); st.b[i]=bc6h_transform_inverse(st.b[i],st.b[0],b0,isSigned); } }
    for (uint i=0u;i<(numPartitions+1u)*2u;i++) { st.r[i]=bc6h_unquantize(st.r[i],b0,isSigned); st.g[i]=bc6h_unquantize(st.g[i],b0,isSigned); st.b[i]=bc6h_unquantize(st.b[i],b0,isSigned); }

    for (uint i=0u;i<16u;i++) {
        uint ps=(st.m_idx>=10u)?((i==0u)?128u:0u):get_p6h(st.partition_index*16u+i), nb=(st.m_idx>=10u)?4u:3u;
        if((ps&128u)!=0u)nb--;
        uint idx=bc6h_read(w,p,nb);
        if (i < 8u) st.idx0 |= (idx << (i * 4u)); else st.idx1 |= (idx << ((i - 8u) * 4u));
